{
  "name": "bitfire-rig",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "bitfire-rig",
      "version": "0.0.0",
      "license": "MIT",
      "workspaces": [
        "packages/*",
        "consumers/*"
      ]
    },
    "consumers/app": {
      "name": "@bitfire/fixture-app",
      "version": "0.0.0",
      "dependencies": {
        "@bitfire/tokens": "*",
        "@bitfire/ui": "*"
      }
    },
    "consumers/docs": {
      "name": "@bitfire/fixture-docs",
      "version": "0.0.0",
      "dependencies": {
        "@bitfire/tokens": "*"
      }
    },
    "node_modules/@bitfire/fixture-app": {
      "resolved": "consumers/app",
      "link": true
    },
    "node_modules/@bitfire/fixture-docs": {
      "resolved": "consumers/docs",
      "link": true
    },
    "node_modules/@bitfire/tokens": {
      "resolved": "packages/tokens",
      "link": true
    },
    "node_modules/@bitfire/ui": {
      "resolved": "packages/ui",
      "link": true
    },
    "packages/tokens": {
      "name": "@bitfire/tokens",
      "version": "2.1.0",
      "license": "MIT"
    },
    "packages/ui": {
      "name": "@bitfire/ui",
      "version": "0.3.0",
      "license": "MIT",
      "peerDependencies": {
        "@bitfire/tokens": "^2.0.0"
      }
    }
  }
}
