{
  "name": "bitfire-rig",
  "private": true,
  "version": "0.0.0",
  "description": "BITFire design system: tokens, components, and the checks that keep them honest",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "consumers/*"
  ],
  "scripts": {
    "generate": "node tools/generate.mjs packages/tokens/src/tokens.json packages/tokens/dist",
    "check:stale": "node tools/check-stale.mjs packages/tokens/src/tokens.json packages/tokens/dist",
    "check:colour": "node tools/check-rawcolour.mjs packages fixtures consumers",
    "check:gates": "bash tools/gate-tests.sh",
    "build:ui": "npm run build --workspace @bitfire/ui",
    "check:build": "npm run check:build --workspace @bitfire/ui",
    "check:app": "node consumers/app/src/app.mjs",
    "check:install": "node tools/check-install.mjs",
    "check": "npm run check:stale && npm run check:colour && npm run check:gates && npm run build:ui && npm run check:build && npm run check:install && npm run check:app && npm run check:a11y && npm run check:visual",
    "app": "node consumers/app/src/app.mjs",
    "check:a11y": "npm run check:a11y --workspace @bitfire/ui",
    "check:visual": "npm run check:visual --workspace @bitfire/ui",
    "visual:update": "npm run visual:update --workspace @bitfire/ui"
  }
}
