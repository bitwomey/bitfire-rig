{
  "name": "@bitfire/ui",
  "version": "0.4.0",
  "description": "BITFire React components",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "@bitfire/tokens": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-aria-components": "^1.22.0"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-themes": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.3",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-aria-components": "^1.22.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "build": "vite build -c vite.lib.config.ts && vite build -c vite.lib.config.ts --mode styles && tsc -p tsconfig.build.json",
    "check:build": "node scripts/check-build.mjs",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run --project=storybook",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:visual": "node scripts/check-visual.mjs",
    "visual:update": "node scripts/check-visual.mjs --update"
  }
}
